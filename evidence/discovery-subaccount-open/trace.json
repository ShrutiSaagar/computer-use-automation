  "finalize": {
    "id": "member.subaccount.open",
    "name": "Open Member Sub-Account",
    "description": "Signs on to the CU-Core back office, looks up a member by member number, and opens a new sub-account of a given type (e.g. Money Market, Share Savings, Certificate, Holiday Club) funded by an opening deposit from the member's primary Share Savings account, posting the account opening to the core. Returns the new account number, confirmation code, and effective date. Requires a valid, active member number and an opening deposit amount that meets the account type's stated minimum (e.g. $25.00 for Money Market). This action is irreversible once \"Open Account\" is confirmed -- it posts to the core.",
    "inputs": [
      {
        "name": "memberNumber",
        "type": "string",
        "description": "The member number to look up and open the sub-account for.",
        "pattern": "^[0-9]{6}$",
        "sensitivity": "identifier",
        "example": "100482"
      },
      {
        "name": "accountType",
        "type": "string",
        "description": "The type of sub-account to open.",
        "enumValues": [
          "Share Savings",
          "Money Market",
          "Certificate",
          "Holiday Club"
        ],
        "sensitivity": "none",
        "example": "Money Market"
      },
      {
        "name": "openingDeposit",
        "type": "number",
        "description": "The opening deposit amount for the new sub-account, must meet the account type's minimum (e.g. $25.00 for Money Market).",
        "pattern": "^[0-9]+\\.[0-9]{2}$",
        "sensitivity": "amount",
        "example": "50.00"
      }
    ],
    "steps": [
      {
        "seq": 0,
        "intent": "Navigate to the back-office application URL.",
        "risk": "safe"
      },
      {
        "seq": 1,
        "intent": "Type the operator username into the Operator ID field.",
        "risk": "safe"
      },
      {
        "seq": 2,
        "intent": "Type the operator password into the Password field.",
        "risk": "safe"
      },
      {
        "seq": 3,
        "intent": "Click Sign On to authenticate.",
        "risk": "safe"
      },
      {
        "seq": 4,
        "intent": "Type the member number into the Member No. search field.",
        "risk": "safe"
      },
      {
        "seq": 5,
        "intent": "Click Search to look up the member.",
        "risk": "safe"
      },
      {
        "seq": 6,
        "intent": "Click New Sub-Account to start the sub-account creation form.",
        "risk": "safe"
      },
      {
        "seq": 7,
        "intent": "Select the desired account type in the Account Type dropdown.",
        "risk": "safe"
      },
      {
        "seq": 8,
        "intent": "Type the opening deposit amount into the Opening Deposit field.",
        "risk": "safe"
      },
      {
        "seq": 9,
        "intent": "Click Continue to move to the review screen.",
        "risk": "safe"
      },
      {
        "seq": 10,
        "intent": "Click Open Account to post the account opening to the core, reaching the confirmation screen.",
        "risk": "irreversible"
      }
    ],
    "droppedSeqs": [],
    "outputs": [
      {
        "name": "newAccountNumber",
        "type": "string",
        "description": "The account number assigned to the newly opened sub-account.",
        "pattern": "^[0-9]{4}-[0-9]{6}$",
        "sensitivity": "account_number"
      },
      {
        "name": "confirmationCode",
        "type": "string",
        "description": "The confirmation code issued for the sub-account opening transaction.",
        "pattern": "^[A-Z0-9-]+$",
        "sensitivity": "identifier"
      },
      {
        "name": "effectiveDate",
        "type": "string",
        "description": "The effective date the new sub-account was opened, in YYYY-MM-DD format.",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "sensitivity": "none"
      }
    ],
    "checkpointText": "Sub-Account Opened",
    "businessOutcomes": [
      {
        "code": "member_not_found",
        "message": "No member found matching that number.",
        "whenTextMatches": "No member found|No results",
        "description": "The member search returns no matching record for the given member number."
      },
      {
        "code": "deposit_below_minimum",
        "message": "Opening deposit does not meet the minimum required for this account type.",
        "whenTextMatches": "min \\$",
        "description": "The opening deposit entered is below the account type's stated minimum (e.g. $25.00 for Money Market), which the form displays as a hint next to the Opening Deposit field."
      }
    ]
  }
