{
  "schemaVersion": "1.1",
  "id": "member.shareSavings.lookup",
  "version": 2,
  "name": "Look up member Share Savings account and balance",
  "description": "Signs on to the CU-Core back office, searches for a member by member number, and reads the Share Savings sub-account number and current balance from the Member Detail screen. Read-only: changes nothing. Input is the member number; outputs are the Share Savings account number and its current balance. Composed: signs on by delegating to the auth.signon skill instead of carrying its own copy of the login steps.",
  "status": "verified",
  "product": {
    "id": "cucore",
    "vendor": "CU-Core Systems",
    "version": "8.2"
  },
  "surface": {
    "kind": "legacy_web",
    "entryUrl": "http://localhost:4310/",
    "deployment": "sandbox"
  },
  "auth": {
    "credentialRef": "env:CU_CORE_OPERATOR",
    "loginStepIds": []
  },
  "uses": [
