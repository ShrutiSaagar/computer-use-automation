{
  "schemaVersion": "1.1",
  "id": "member.subaccount.open",
  "version": 2,
  "name": "Open Member Sub-Account",
  "description": "Signs on to the CU-Core back office, looks up a member by member number, and opens a new sub-account of a given type (e.g. Money Market, Share Savings, Certificate, Holiday Club) funded by an opening deposit from the member's primary Share Savings account, posting the account opening to the core. Returns the new account number, confirmation code, and effective date. Requires a valid, active member number and an opening deposit amount that meets the account type's stated minimum (e.g. $25.00 for Money Market). This action is irreversible once \"Open Account\" is confirmed -- it posts to the core. Composed: signs on via the auth.signon skill, and verifies the member exists -- and lands on their profile -- by delegating to member.shareSavings.lookup before anything irreversible may run. A MEMBER_NOT_FOUND from that check IS the caller's answer, not a failure.",
  "status": "verified",
  "product": {
    "id": "cucore",
    "vendor": "CU-Core Systems",
    "version": "8.2"
  },
  "surface": {
    "kind": "legacy_web",
    "entryUrl": "http://localhost:4310/",
    "deployment": "sandbox"
  },
  "auth": {
    "credentialRef": "env:CU_CORE_OPERATOR",
    "loginStepIds": []
  },
  "uses": [
    {
      "name": "signon",
      "capabilityId": "auth.signon",
      "version": "*",
      "purpose": "establish the operator session"
    },
    {
      "name": "lookup",
      "capabilityId": "member.shareSavings.lookup",
      "version": "*",
      "purpose": "verify the member exists and land on their profile before any irreversible step may run"
    }
  ],
  "requires": {
    "session": {
      "describe": "an authenticated operator session (the sign-on screen is gone)",
      "check": {
        "node_absent": {
          "role": "button",
          "name": "Sign On"
        }
      },
      "establish": {
        "uses": "signon"
      },
      "onNotMet": "establish"
    },
    "data": [
      {
        "name": "member_exists",
        "describe": "the member exists and their profile can be opened; the check is a read-only lookup",
        "via": "lookup",
        "args": {
          "memberNumber": {
            "$param": "memberNumber"
          }
        },
        "notMetOutcomes": [
          "MEMBER_NOT_FOUND"
        ],
        "onNotMet": "propagate"
      }
    ]
  },
  "inputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "description": "The member number to look up and open the sub-account for.",
      "required": true,
      "pattern": "^[0-9]{6}$",
      "sensitivity": "identifier",
      "example": "100482"
    },
    {
      "name": "accountType",
      "type": "string",
      "description": "The type of sub-account to open.",
      "required": true,
      "enum": [
        "Share Savings",
        "Money Market",
        "Certificate",
        "Holiday Club"
      ],
      "sensitivity": "none",
      "example": "Money Market"
    },
    {
      "name": "openingDeposit",
      "type": "number",
      "description": "The opening deposit amount for the new sub-account, must meet the account type's minimum (e.g. $25.00 for Money Market).",
      "required": true,
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "sensitivity": "amount",
      "example": "50.00"
    }
  ],
  "outputs": [
    {
      "name": "newAccountNumber",
      "type": "string",
      "description": "The account number assigned to the newly opened sub-account.",
      "from": {
        "description": "The newly created sub-account number for the Money Market account.",
        "frame": {
          "index": 2
        },
        "strategies": [
          {
