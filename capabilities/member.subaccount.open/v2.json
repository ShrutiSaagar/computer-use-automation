          },
          {
            "kind": "coords",
            "nx": 0.1772,
            "ny": 0.0894
          }
        ],
        "recordedRank": 0,
        "guard": {
          "role": "cell",
          "tag": "td"
        }
      },
      "extract": "text",
      "pattern": "^[0-9]{4}-[0-9]{6}$",
      "sensitivity": "account_number"
    },
    {
