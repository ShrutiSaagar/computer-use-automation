# Operator credentials for the CU-Core target app.
# The capability artifact stores only the REFERENCE "env:CU_CORE_OPERATOR" --
# never these values. See src/policy/redact.ts.
CU_CORE_OPERATOR_USERNAME=svc.automation
CU_CORE_OPERATOR_PASSWORD=Tr0ubador-Demo-2026

# Optional. The learning engine uses your Claude Code subscription credentials by
# default; setting this makes it use the API key instead. Same code path.
# ANTHROPIC_API_KEY=sk-ant-...
